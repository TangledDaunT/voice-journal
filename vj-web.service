[Unit]
Description=Voice Journal Web Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/shreyansh/voice_journal_src
ExecStart=/home/shreyansh/voice_journal_src/venv/bin/python3 web/app.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

# Environment variables example
# Copy to .env and fill in your values

# Obsidian vault path (optional - defaults to ./obsidian_vault)
VJ_OBSIDIAN__VAULT_PATH=/path/to/your/obsidian/vault

# Ollama host (optional - defaults to http://localhost:11434)
VJ_LLM__OLLAMA_HOST=http://localhost:11434

# Log level (optional - defaults to INFO)
VJ_DAEMON__LOG_LEVEL=INFO

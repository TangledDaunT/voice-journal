# Environment variables example
# Copy to .env and fill in your values

# DATA_ROOT: Root directory for all voice journal data (default: auto-detected external drive)
# Will be auto-detected if not set, checking /media, /mnt for external drives
# Mount the external 1 TB disk here before starting Docker.
DATA_ROOT=/mnt/voice-journal

# Daemon resource limits (for Docker)
DAEMON_CPUS=2.0
DAEMON_MEMORY=2G
DAEMON_CPUS_RESERVE=0.5
DAEMON_MEMORY_RESERVE=512M

# Web resource limits (for Docker)
WEB_CPUS=1.0
WEB_MEMORY=1G
WEB_CPUS_RESERVE=0.25
WEB_MEMORY_RESERVE=256M

# Transcription resource limits (for Docker)
TRANSCRIBE_CPUS=2.0
TRANSCRIBE_MEMORY=4G
TRANSCRIBE_CPUS_RESERVE=0.5
TRANSCRIBE_MEMORY_RESERVE=1G

# Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BLOCK_SIZE=512
AUDIO_RING_BUFFER_SECONDS=30

# VAD settings
VAD_THRESHOLD=0.5
VAD_MIN_SEGMENT_DURATION=0.5
VAD_SILENCE_PADDING=0.3
VAD_MAX_SEGMENT_DURATION=30.0

# ASR settings
ASR_MODEL_SIZE=small
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_LANGUAGE=null  # Auto-detect Hindi/English
ASR_BEAM_SIZE=5
ASR_COMPRESSION_RATIO_THRESHOLD=2.4
ASR_NO_REPEAT_NGRAM_SIZE=3
ASR_REPETITION_PENALTY=1.3
ASR_VAD_FILTER=true
ASR_CONDITION_ON_PREVIOUS_TEXT=false  # Prevent hallucination cascade
ASR_INITIAL_PROMPT="Shreyansh, Shivangi. Use only Hindi and English; do not output any other language."
ASR_NO_SPEECH_PROB_THRESHOLD=0.5
ASR_AVG_LOGPROB_THRESHOLD=-1.0

# Preprocessing settings
PREPROCESSING_ENABLE_DENOISING=true
PREPROCESSING_DENOISING_METHOD=noisereduce  # or "rnnoise"
PREPROCESSING_GAIN_NORMALIZATION=true
PREPROCESSING_TARGET_DB=-20.0  # Target loudness in dB
PREPROCESSING_MIN_RMS_DB_FOR_ASR=-55.0  # Skip near-silent merged units before Whisper

# Segment merging settings
SEGMENT_MERGING_MERGE_GAP_SECONDS=2.5
SEGMENT_MERGING_MIN_TRANSCRIPTION_UNIT_SECONDS=5.0
SEGMENT_MERGING_MAX_TRANSCRIPTION_UNIT_SECONDS=20.0

# Conversation grouping settings
CONVERSATION_GAP_SECONDS=90
CONVERSATION_MIN_SEGMENTS=2
CONVERSATION_UNKNOWN_VOICE_RATIO_THRESHOLD=0.7
CONVERSATION_RAPID_ALTERNATION_THRESHOLD=3.0

# Batch processing scheduler settings
SCHEDULER_CPU_IDLE_THRESHOLD=30.0  # Percentage
SCHEDULER_MIN_IDLE_DURATION_SECONDS=60
SCHEDULER_IDLE_CHECK_INTERVAL=30
SCHEDULER_PROCESS_ALL_DAY=true  # Process backlog continuously; do not wait for CPU idle/night
SCHEDULER_DAYTIME_BATCH_HOURS=0.5  # 30 min of audio (~1 min of processing)
SCHEDULER_OVERNIGHT_BATCH_HOURS=2.0  # 2 hours of audio (~4-5 min of processing)
SCHEDULER_BACKLOG_OVERFLOW_HOURS=24.0
SCHEDULER_FALLBACK_MODEL=large-v3
SCHEDULER_FALLBACK_COMPUTE_TYPE=int8
SCHEDULER_GUARANTEED_WINDOW_START_HOUR=22  # 10 PM
SCHEDULER_GUARANTEED_WINDOW_END_HOUR=6    # 6 AM
SCHEDULER_GUARANTEED_WINDOW_ENABLED=true

# Backlog tracking settings
BACKLOG_WARN_ON_GROWTH=true
BACKLOG_MAX_STAGING_HOURS=72

# System settings
SYSTEM_NOTIFY_ON_MUTE=true
SYSTEM_HOTKEY_MUTE="ctrl+shift+m"

# Dashboard settings
DASHBOARD_AUDIO_CACHE_PATH=${DATA_ROOT:-/home/shreyansh/NAS}/voice-journal/audio_cache
DASHBOARD_AUDIO_RETENTION_DAYS=30
DASHBOARD_AUDIO_BITRATE_KBPS=32

# Daemon settings
DAEMON_LOG_LEVEL=INFO
DAEMON_LOG_FILE=./logs/voice_journal.log
DAEMON_MUTE_FILE=./data/mute_flag
DAEMON_HEALTH_CHECK_INTERVAL=60

# Authentication for web dashboard (optional but recommended)
WEB_AUTH_TOKEN=your-secret-token-here  # Change this to a secure random token
